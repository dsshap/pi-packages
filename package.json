{
  "name": "pi-packages",
  "version": "1.0.0",
  "private": true,
  "description": "Custom extensions for pi, the AI coding agent",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "npm run lint && npm run typecheck",
    "check:ci": "biome ci . && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "npx tsx packages/pi-agent-chain/__tests__/chain-runtime-validate.mts",
    "test:e2e:spawn": "node packages/pi-agent-chain/__tests__/spawn-validate.mjs",
    "test:e2e:abort": "npx tsx packages/pi-agent-chain/__tests__/abort-validate.mts",
    "test:e2e:shutdown": "npx tsx packages/pi-agent-chain/__tests__/shutdown-validate.mts"
  },
  "workspaces": [
    "packages/*",
    "libraries/*"
  ],
  "keywords": [
    "pi",
    "pi-package",
    "pi-packages",
    "pi-extensions",
    "pi-coding-agent",
    "extensions",
    "ai",
    "coding-assistant"
  ],
  "pi": {
    "extensions": [
      "./packages/pi-grid-manager/extensions/index.ts",
      "./packages/pi-pi-experts/extensions/index.ts",
      "./packages/pi-agent-chain/extensions/index.ts"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@earendil-works/pi-agent-core": "^0.74.0",
    "@earendil-works/pi-ai": "^0.74.0",
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@earendil-works/pi-tui": "^0.74.0",
    "@types/node": "^22.0.0",
    "typebox": "^1.1.24",
    "typescript": "^5.5.0",
    "vitest": "^4.0.18"
  },
  "license": "MIT"
}
