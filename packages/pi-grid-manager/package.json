{
	"name": "@dsshap/pi-grid-manager",
	"version": "1.0.0",
	"description": "Pi Grid Manager — UI middleware that intercepts ui.setWidget() calls from other extensions and composes them into a single grid widget with dynamic per-row width allocation. Configurable columns via /grid <N>. Downstream extensions need zero changes.",
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"pi-coding-agent",
		"grid",
		"layout",
		"ui"
	],
	"type": "module",
	"files": [
		"extensions/",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./extensions/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.74.0",
		"@earendil-works/pi-tui": ">=0.74.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dsshap/pi-packages.git",
		"directory": "packages/pi-grid-manager"
	},
	"author": "dsshap",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/dsshap/pi-packages/issues"
	},
	"homepage": "https://github.com/dsshap/pi-packages/tree/main/packages/pi-grid-manager#readme"
}
